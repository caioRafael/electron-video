{
  "name": "video-lab-desktop",
  "version": "0.1.2",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "node scripts/prepare-ffmpeg.mjs && electron-vite preview",
    "dev": "node scripts/prepare-ffmpeg.mjs && electron-vite dev",
    "build": "node scripts/prepare-ffmpeg.mjs && npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "prepare:ffmpeg": "node scripts/prepare-ffmpeg.mjs",
    "verify:media": "node scripts/verify-media-runtime.mjs",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "node scripts/prepare-ffmpeg.mjs --platform win32-x64 && npm run build && electron-builder --win",
    "build:mac": "node scripts/prepare-ffmpeg.mjs && electron-vite build && electron-builder --mac",
    "build:linux": "node scripts/prepare-ffmpeg.mjs --platform linux-x64 && npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "electron-updater": "^6.3.9",
    "radix-ui": "^1.6.7",
    "react-resizable-panels": "^4.12.4",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@rocketseat/eslint-config": "^2.2.2",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^8.57.1",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
